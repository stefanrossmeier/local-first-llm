# Copy to .env and change only what you need.

# Hugging Face model and the API-visible model directory name.
HF_MODEL=mlx-community/Qwen3.8-27B-4bit
# Required immutable Hugging Face commit SHA for the tested model snapshot.
# Find it on the model's Files and versions page; do not use main, a branch, or a tag.
#HF_MODEL_REVISION=3e6447f082e89cc7f0bc6e5441afd38dfce760ff
HF_MODEL_REVISION=REPLACE_WITH_40_CHARACTER_COMMIT_SHA
MODEL_ID=Qwen3.8-27B-4bit

# Models are stored as $MODEL_ROOT/$MODEL_ID.
MODEL_ROOT=$HOME/llm/Models/MLX

# oMLX and inspection proxy ports.
OMLX_HOST=127.0.0.1
OMLX_PORT=8000
PROXY_HOST=127.0.0.1
PROXY_PORT=8001

# Runtime logs created by scripts/start.sh.
RUNTIME_LOG_DIR=$HOME/llm/logs

# Proxy request logs. Summary JSON is always written.
# Set to 1 only while debugging: raw requests may contain source code,
# workspace instructions, tool schemas, paths, and other private context.
COPILOT_PROXY_LOG_RAW=0
# Number of characters of each message body stored in summary previews.
# 0 is safest for normal use; raise temporarily when investigating context.
COPILOT_PROXY_PREVIEW_CHARS=0

# Default direct API benchmark settings.
BENCH_REASONING_EFFORT=low
BENCH_MAX_TOKENS=1024
