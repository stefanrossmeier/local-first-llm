# Qwen3.8-distilled MoE experiment profile.
# Community MLX 4-bit conversion of empero-ai/Qwen3.8-35B-A3B-Distill.
HF_MODEL=nvythong/Qwen3.8-35B-A3B-Distill-mlx-4Bit
HF_MODEL_REVISION=220dfec3e716bbae93bd66b643e36b2ffe6853ff
MODEL_ID=Qwen3.8-35B-A3B-Distill-mlx-4Bit

# Keep the first experiment comparable and conservative on the M4 Pro / 48 GB
# machine. oMLX caps prompt input at 32,768 tokens; the VS Code profile advertises
# 28,672 input + 4,096 output tokens = a 32,768-token client-side budget.
MODEL_MAX_CONTEXT_WINDOW=32768
MODEL_ENABLE_THINKING=true
MODEL_PRESERVE_THINKING=false
MODEL_THINKING_BUDGET_ENABLED=false

# Baseline inference profile. Leave acceleration experiments for a later A/B
# step so the first measurements describe the model/runtime without MTP,
# ANE prefill, DFlash, expert offload, or KV-cache quantization enabled.
MODEL_MTP_ENABLED=false
MODEL_QWEN35_ANE_PREFILL_ENABLED=false
MODEL_TURBOQUANT_KV_ENABLED=false
MODEL_QWEN35_OQ_A8_ENABLED=false
MODEL_SPEC_PREFILL_ENABLED=false
MODEL_DFLASH_ENABLED=false
MODEL_MOE_EXPERT_OFFLOAD_ENABLED=false

# Reproducible inference-engineering suite defaults.
BENCH_CONTEXT_LENGTHS=1024,4096,8192,16384,32768
BENCH_CONTEXT_RUNS=2
BENCH_GENERATION_TOKENS=256
BENCH_PREFIX_TOKENS=8192
BENCH_PREFIX_MAX_TOKENS=128
BENCH_CONCURRENCY_PROMPT_TOKENS=4096
BENCH_CONCURRENCY_LEVELS=1,2,4,8
BENCH_CONCURRENCY_MAX_TOKENS=128
BENCH_SLO_TTFT_SECONDS=15
BENCH_SLO_MIN_TG_TPS=30
